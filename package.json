{
  "name": "ai-agent-code-lab",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 源码精读系列：解析文档 + 简化版复现代码（pnpm monorepo）",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "articles/*"
  ],
  "scripts": {
    "run:dsh-loop": "tsx articles/dsh-agent-loop/src/steps/step-07-full.ts",
    "run:dsh-tools": "tsx articles/dsh-tools/src/steps/step-07-parallel-scheduler.ts",
    "run:dsh-context": "tsx articles/dsh-context/src/steps/step-07-session-reference-full-assembly.ts",
    "tools:step:01": "tsx articles/dsh-tools/src/steps/step-01-minimal-pipeline.ts",
    "tools:step:02": "tsx articles/dsh-tools/src/steps/step-02-arg-materialization.ts",
    "tools:step:03": "tsx articles/dsh-tools/src/steps/step-03-approval-pipeline.ts",
    "tools:step:04": "tsx articles/dsh-tools/src/steps/step-04-monotonic-guards.ts",
    "tools:step:05": "tsx articles/dsh-tools/src/steps/step-05-cooperative-cancel.ts",
    "tools:step:06": "tsx articles/dsh-tools/src/steps/step-06-timeout-policy.ts",
    "tools:step:07": "tsx articles/dsh-tools/src/steps/step-07-parallel-scheduler.ts",
    "context:step:01": "tsx articles/dsh-context/src/steps/step-01-system-prompt-registry.ts",
    "context:step:02": "tsx articles/dsh-context/src/steps/step-02-scope-and-variables.ts",
    "context:step:03": "tsx articles/dsh-context/src/steps/step-03-waterfall-complete.ts",
    "context:step:04": "tsx articles/dsh-context/src/steps/step-04-runtime-context-snapshot.ts",
    "context:step:05": "tsx articles/dsh-context/src/steps/step-05-agent-instructions.ts",
    "context:step:06": "tsx articles/dsh-context/src/steps/step-06-time-tmux-context.ts",
    "context:step:07": "tsx articles/dsh-context/src/steps/step-07-session-reference-full-assembly.ts",
    "step:01": "tsx articles/dsh-agent-loop/src/steps/step-01-minimal.ts",
    "step:02": "tsx articles/dsh-agent-loop/src/steps/step-02-tools-declared.ts",
    "step:03": "tsx articles/dsh-agent-loop/src/steps/step-03-execute-and-feedback.ts",
    "step:04": "tsx articles/dsh-agent-loop/src/steps/step-04-state-machine.ts",
    "step:05": "tsx articles/dsh-agent-loop/src/steps/step-05-kick-wake.ts",
    "step:06": "tsx articles/dsh-agent-loop/src/steps/step-06-pre-step.ts",
    "step:07": "tsx articles/dsh-agent-loop/src/steps/step-07-full.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}
