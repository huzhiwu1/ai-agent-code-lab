{
  "name": "ai-agent-code-lab",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 源码精读系列：解析文档 + 简化版复现代码（pnpm monorepo）",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "articles/*"
  ],
  "scripts": {
    "run:dsh-loop": "tsx articles/dsh-agent-loop/src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}
